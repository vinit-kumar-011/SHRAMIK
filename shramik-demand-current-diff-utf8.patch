 .summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.summary-panel{min-height:244px;padding:13px 13px 10px}.summary-panel .panel-header{align-items:flex-start}.summary-panel .panel-header h2{font-size:22px}.summary-panel .panel-header p{font-size:11px}.button-outline{height:31px;padding:0 9px;border:1px solid #AAA79D;border-radius:6px;background:#FFFEF8;font-size:11px;font-weight:600}.button-outline:hover{border-color:var(--ink);background:var(--yellow)}.data-rows{margin-top:8px}.data-row{width:100%;height:32px;display:grid;grid-template-columns:22px minmax(80px,1fr) auto minmax(55px,30%);align-items:center;gap:8px;padding:2px 1px;border:0;border-top:1px solid transparent;background:transparent;text-align:left}.data-row:hover{background:rgba(242,211,79,.14)}.row-icon{display:flex;align-items:center;justify-content:center;color:var(--ink)}.row-icon.tone-navy{color:var(--navy)}.row-icon.tone-teal{color:var(--teal)}.row-icon.tone-orange{color:var(--orange)}.row-name{font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.row-delta{font-size:11px;color:var(--success);white-space:nowrap}.row-value{font-size:11px;color:#292929;white-space:nowrap}.bar-track{display:block;height:17px;border-radius:3px;background:#E8E5DA;overflow:hidden}.bar-fill{display:block;height:100%;border-radius:2px;background:var(--tone)}.tone-navy.bar-fill{background:var(--navy)}.tone-teal.bar-fill{background:var(--teal)}.tone-orange.bar-fill{background:var(--orange)}.summary-gaps .data-row{grid-template-columns:22px minmax(78px,1fr) auto minmax(75px,40%)}.summary-forecasts .data-row{grid-template-columns:22px minmax(85px,1fr) auto minmax(62px,29%)}.method-note{min-height:42px;display:flex;align-items:center;gap:9px;color:#5D5B54;padding:11px 2px 0;font-size:11px}.note-marker{display:grid;place-items:center;width:17px;height:17px;flex:0 0 17px;border:1px solid #AAA79B;border-radius:50%;font:700 11px Georgia,serif}.method-note p{margin:0;line-height:1.35;flex:1}.method-note strong{color:#30302B}.updated{display:flex;align-items:center;gap:5px;white-space:nowrap;color:#66645E;font-size:10px}.toast-message{position:fixed;z-index:80;right:22px;bottom:22px;max-width:min(450px,calc(100vw - 32px));display:flex;align-items:flex-start;gap:12px;padding:13px 14px;border:1.2px solid var(--border);border-radius:7px;box-shadow:4px 4px 0 var(--ink);background:#fffef8;font-size:13px}.toast-message button{border:0;background:transparent;padding:0;display:grid;place-items:center;flex:0 0 20px}.mobile-scrim{display:none}
