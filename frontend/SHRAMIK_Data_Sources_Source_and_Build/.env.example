# Leave empty for the local SYNTHETIC_DEMO adapter.
# Set this to the SHRAMIK backend API base that already includes /api/v1.
# Example: VITE_DATA_SOURCES_API_BASE_URL=/api/v1
VITE_DATA_SOURCES_API_BASE_URL=

# Optional features. Do not enable unless the matching authenticated server routes and permissions are implemented.
VITE_DATA_SOURCES_ENABLE_CREATE=false
VITE_DATA_SOURCES_ENABLE_INGESTION=false
