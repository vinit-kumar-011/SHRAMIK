# SHRAMIK unified frontend environment
# Leave each API variable blank to use its explicitly labelled local/demo adapter.
# Module APIs may share the same API host URL, but each is opted in independently
# so a partially implemented backend does not switch unrelated modules to REST mode.

# Vite base URL for deployment. Empty means root hosting (/).
# Set to /shramik/ only if production serves the app from that subpath.
VITE_BASE_PATH=

# Dashboard, Skill Gaps, Forecasts and Reports adapter host.
VITE_SHRAMIK_API_BASE_URL=

# Optional per-module hosts (can point to the same server, if it implements that module's contract).
VITE_DEMAND_API_BASE_URL=
VITE_SUPPLY_API_BASE_URL=
VITE_EMERGING_SKILLS_API_BASE_URL=
VITE_SCENARIO_SIMULATOR_API_BASE_URL=
VITE_DATA_QUALITY_API_BASE_URL=
VITE_ADMINISTRATION_API_BASE_URL=

# Data Sources registry, separately configured to keep create/ingestion controls opt-in.
VITE_DATA_SOURCES_API_BASE_URL=
VITE_DATA_SOURCES_ENABLE_CREATE=false
VITE_DATA_SOURCES_ENABLE_INGESTION=false
