# SHRAMIK unified frontend environment
# Leave API host variables empty for the labelled local/demo adapters.
# Do not enable write-capable features until the corresponding server endpoints,
# authentication, and authorization checks are deployed and verified.

# Vite base URL for deployment. Empty means root hosting (/).
# Set to /shramik/ for a project-subpath deployment.
VITE_BASE_PATH=

# Shared SHRAMIK REST API host (dashboard, Demand Insights, Skill Gaps, Emerging Skills, Scenario Simulator).
# The current backend scaffold exposes health/docs only; leave blank until the
# required versioned analytical endpoints are available.
VITE_SHRAMIK_API_BASE_URL=

# Separate Data Sources adapter host.
# Leave blank for local synthetic demo data.
VITE_DATA_SOURCES_API_BASE_URL=
VITE_DATA_SOURCES_ENABLE_CREATE=false
VITE_DATA_SOURCES_ENABLE_INGESTION=false
