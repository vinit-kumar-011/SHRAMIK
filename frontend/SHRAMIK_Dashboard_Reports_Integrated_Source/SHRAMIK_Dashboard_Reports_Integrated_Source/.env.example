# SHRAMIK unified frontend environment
# The canonical dashboard connects to the project's published Supabase data by default.
# The URL and publishable key are public browser configuration, not secrets. Never put
# a service_role or secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set true to exercise the official-only showcase experience during local development.
# Production builds always enable showcase mode regardless of this flag.
VITE_SHRAMIK_SHOWCASE_MODE=false

# Set true only for an explicitly labelled local demo with illustrative dashboard numbers.
# This flag is ignored in production/showcase mode.
VITE_SHRAMIK_USE_DEMO_DATA=false

# Origin of the approved SHRAMIK FastAPI service.
# The protected Forecasts and Emerging Skills views require this in production.
# Set it only after verifying that the deployed backend OpenAPI exposes /api/v1/analytics/*,
# /api/v1/districts and /api/v1/skills. Do not point it at a health-only/stale deployment.
VITE_SHRAMIK_API_BASE_URL=

# The Dashboard's legacy REST adapter uses this host only when explicitly selected.
# The normal Dashboard data path remains the source-backed Supabase adapter.
VITE_SHRAMIK_DATA_MODE=

# Optional per-module hosts (each module is independently opted in).
VITE_DEMAND_API_BASE_URL=
VITE_SUPPLY_API_BASE_URL=
VITE_EMERGING_SKILLS_API_BASE_URL=
VITE_SCENARIO_SIMULATOR_API_BASE_URL=
VITE_DATA_QUALITY_API_BASE_URL=
VITE_ADMINISTRATION_API_BASE_URL=

# Data Sources registry, separately configured to keep create/ingestion controls opt-in.
VITE_DATA_SOURCES_API_BASE_URL=
VITE_DATA_SOURCES_ENABLE_CREATE=false
VITE_DATA_SOURCES_ENABLE_INGESTION=false

# Vite base URL. Empty means root hosting; set /shramik/ only for a subpath deploy.
VITE_BASE_PATH=
