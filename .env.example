# ==============================
# SHRAMIK Environment Variables
# ==============================

# Database
DATABASE_URL=

# Supabase (server-side only; never expose the service-role key in frontend code)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
LLM_API_KEY=

# Application
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Source ingestion: server-side only. Never use NEXT_PUBLIC_ for any value below.
# Generate the key while signed in to https://www.data.gov.in/.
OGD_API_KEY=
# Generate a high-entropy token and store it only in the backend runtime secrets.
INGESTION_ADMIN_TOKEN=

# Set these to the resource IDs shown on the exact OGD resource's Data API page.
# Keep blank until the resource contract, fields, and access terms have been checked.
OGD_ESHRAM_RESOURCE_ID=
OGD_UDYAM_RESOURCE_ID=
OGD_MGNREGA_RESOURCE_ID=
OGD_JSS_RESOURCE_ID=
OGD_TIMEOUT_SECONDS=20
