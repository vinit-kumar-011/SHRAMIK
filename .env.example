# ==============================
# SHRAMIK Environment Variables
# ==============================

# Database
DATABASE_URL=

# Supabase (server-side only; never expose the service-role key in frontend code)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
LLM_API_KEY=

# Application
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Source ingestion: server-side only. Never use NEXT_PUBLIC_ for any value below.
# Generate the key while signed in to https://www.data.gov.in/.
OGD_API_KEY=
# Generate a high-entropy token and store it only in the backend runtime secrets.
INGESTION_ADMIN_TOKEN=

# Resource IDs supplied by the user for candidate sources. Verify each title/schema
# through the protected preview endpoint before enabling sync or normalisation.
# The total district-wise UDYAM resource ID is f8cd85a1-f9b8-4ff1-b195-9f75c10eb338.
OGD_ESHRAM_RESOURCE_ID=1d4d1c5a-feea-423b-be4f-c3636fdd1d82
OGD_UDYAM_RESOURCE_ID=f8cd85a1-f9b8-4ff1-b195-9f75c10eb338
# Resource IDs are configured for preview; do not infer semantic equivalence from IDs alone.
OGD_UDYAM_SERVICES_RESOURCE_ID=c3dfe7e6-0cfd-4ddb-8f79-9cb3695d9866
OGD_UDYAM_MANUFACTURING_RESOURCE_ID=ae789703-638a-4942-b79e-17868103dec8
OGD_MGNREGA_RESOURCE_ID=ee03643a-ee4c-48c2-ac30-9f2ff26ab722
OGD_JSS_RESOURCE_ID=6bd63a89-58cc-4a25-971e-7fb1e5f6775f
OGD_TIMEOUT_SECONDS=20
